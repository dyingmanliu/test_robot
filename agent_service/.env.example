# agent_service 环境变量示例（复制为 .env）

# ── 用例生成 LLM ─────────────────────────────────────────────
# CASE_GEN_API_KEY=
# CASE_GEN_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# CASE_GEN_MODEL=glm-4-flash
# CASE_GEN_TIMEOUT_SEC=60
# CASE_GEN_USE_KB=true
# CASE_GEN_KB_LIMIT=3

# ── 功能测试 AutoGLM ─────────────────────────────────────────
# BIGMODEL_API_KEY=
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# PHONE_AGENT_MODEL=autoglm-phone
# PHONE_AGENT_MAX_STEPS=100
# PHONE_AGENT_TIMEOUT_SEC=120

# ── Midscene ─────────────────────────────────────────────────
# MIDSCENE_MODEL_BASE_URL=
# MIDSCENE_REPLANNING_CYCLE_LIMIT=100
# MIDSCENE_STEP_TIMEOUT_SEC=180

# Retriever 调 Web internal KB（与 web/backend/.env 的 WEB_SERVICE_TOKEN 必须相同）
WEB_INTERNAL_API_URL=http://127.0.0.1:8000
WEB_SERVICE_TOKEN=change-me-shared-with-web-backend

# ── LangSmith（LangChain 追踪，可选）────────────────────────────────────────
# 配置 LANGSMITH_API_KEY 后默认开启；显式关闭：LANGCHAIN_TRACING_V2=false
# LANGSMITH_API_KEY=
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=test-robots
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── 服务 ─────────────────────────────────────────────────────
# AGENT_SERVICE_HOST=0.0.0.0
# AGENT_SERVICE_PORT=8100

# ── 日志（与 web/backend 一致）────────────────────────────────
# LOG_LEVEL=INFO
# LOG_FORMAT=detailed          # detailed | simple | custom（配合 LOG_FORMAT_TEMPLATE）
# LOG_FORMAT_TEMPLATE=%(asctime)s | %(message)s
# LOG_HTTP_QUERY=1
# LOG_HTTP_QUIET_POLLS=        # 设为 1 时 /health、/stream 降为 DEBUG
# LOG_HTTP=                    # 设为 1 时输出 httpx/httpcore 请求日志
