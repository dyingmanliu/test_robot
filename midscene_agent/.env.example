# =============================================================================
# midscene_agent 环境变量（也可写在仓库根目录 .env，CLI 会优先加载根目录 .env）
# =============================================================================

# --- Midscene 视觉模型（必填，见 https://midscenejs.com/model-config）---
# 推荐 GLM-V（支持 aiAssert）；智谱示例见 https://midscenejs.com/model-common-config
MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=qwen3.6-plus
MIDSCENE_MODEL_FAMILY=qwen3.6

# --- HarmonyOS 设备 (HDC) ---
# 多设备时指定 serial（hdc list targets）
# HDC_DEVICE_ID=
# 留空则使用 PATH 中的 hdc；未在 PATH 时指向 toolchains 目录（内含 hdc）
# HDC_HOME=/Applications/DevEco-Studio.app/Contents/sdk/default/openharmony/toolchains

# --- Agent 行为 ---
# MIDSCENE_AI_ACTION_CONTEXT=HarmonyOS 6.0 设备，系统语言为中文…
# MIDSCENE_AUTO_DISMISS_KEYBOARD=true
# MIDSCENE_QUIET=0

# CI 报告目录（可选）
# MIDSCENE_RUN_DIR=./midscene_run
