# =============================================================================
# midscene_agent 环境变量（也可写在仓库根目录 .env，CLI 会优先加载根目录 .env）
# =============================================================================

# --- Midscene 视觉模型（必填，见 https://midscenejs.com/model-config）---
# 千问 3.6（DashScope）
MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=qwen3.6-plus
MIDSCENE_MODEL_FAMILY=qwen3.6

# 智谱 GLM-V 示例：
# MIDSCENE_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MIDSCENE_MODEL_API_KEY=
# MIDSCENE_MODEL_NAME=glm-5v-turbo
# MIDSCENE_MODEL_FAMILY=glm-v

# --- 平台与引擎（CLI；Web 执行时由下发 JSON 覆盖）---
# MIDSCENE_DEVICE_PLATFORM=harmonyos    # android | harmonyos
# MIDSCENE_AGENT_BACKEND=midscene       # 仅 Midscene 引擎走本子项目；AutoGLM+鸿蒙 见 autoglm_phone_agent

# --- Android 设备 (ADB) ---
# ADB_DEVICE_ID=

# --- HarmonyOS 设备 (HDC) ---
# HDC_DEVICE_ID=
# HDC_HOME=/Applications/DevEco-Studio.app/Contents/sdk/default/openharmony/toolchains

# --- Agent 行为 ---
# MIDSCENE_AI_ACTION_CONTEXT=设备系统语言可能为中文…
# MIDSCENE_AUTO_DISMISS_KEYBOARD=true
# MIDSCENE_QUIET=0
# MIDSCENE_REPLANNING_CYCLE_LIMIT=50   # 复杂任务提高重规划次数（默认 20）

# CI 报告目录（可选）
# MIDSCENE_RUN_DIR=./midscene_run
