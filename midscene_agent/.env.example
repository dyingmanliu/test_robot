# =============================================================================
# midscene_agent 环境变量（也可写在仓库根目录 .env，CLI 会优先加载根目录 .env）
# =============================================================================

# --- Midscene 视觉模型（必填，见 https://midscenejs.com/model-config）---
MIDSCENE_MODEL_BASE_URL=https://replace-with-your-model-service-url/v1
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=
MIDSCENE_MODEL_FAMILY=

# --- HarmonyOS 设备 (HDC) ---
# 多设备时指定 serial（hdc list targets）
# HDC_DEVICE_ID=
# hdc 不在 PATH 时指向目录（内含 hdc 可执行文件）
# HDC_HOME=/path/to/hdc/bin

# --- Agent 行为 ---
# MIDSCENE_AI_ACTION_CONTEXT=HarmonyOS 6.0 设备，系统语言为中文…
# MIDSCENE_AUTO_DISMISS_KEYBOARD=true
# MIDSCENE_QUIET=0

# CI 报告目录（可选）
# MIDSCENE_RUN_DIR=./midscene_run
