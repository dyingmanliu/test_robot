# mai_ui_agent — 本地 MAI-UI-2B（Mac Apple Silicon 推荐，见 README.md）
# 可复制到仓库根目录 .env，或放在本目录 .env

# vllm-mlx 本地推理（推荐 Mac + MLX，见 scripts/serve_vllm_mlx.sh）
# 推荐：mlx_vlm 本地推理（Web 需另开 scripts/serve_grounding_mlx.sh）
MAI_UI_BACKEND=mlx_vlm
MAI_UI_GROUNDING_URL=http://127.0.0.1:8101
MAI_UI_MODEL_PATH=

MAI_UI_BASE_URL=http://127.0.0.1:8100/v1
MAI_UI_API_KEY=empty
MAI_UI_MODEL=MAI-UI-2B

# 若使用 Ollama：MAI_UI_BASE_URL=http://127.0.0.1:11434/v1
# MAI_UI_API_KEY=ollama
# MAI_UI_MODEL=maternion/mai-ui:2b
# 或本地目录: MAI_UI_MODEL=/path/to/mai_ui_agent/models/MAI-UI-2B-bf16-v2

MAI_UI_TEMPERATURE=0
MAI_UI_TOP_P=1
MAI_UI_TOP_K=-1
MAI_UI_MAX_TOKENS=512
MAI_UI_MAX_IMAGE_LONG_EDGE=1280
MAI_UI_MAX_RETRIES=3
# MAI_UI_VERBOSE=1
