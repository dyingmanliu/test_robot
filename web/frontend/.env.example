# 复制为 web/frontend/.env 或 .env.local（本地覆盖，勿提交密钥）
# cp .env.example .env

# 开发环境一般留空：浏览器请求同源 /api，由 Vite 代理到后端（vite.config.js）
# 部署到 API 网关或直连远端后端时填写完整 origin，例如：https://api.example.com
VITE_API_BASE=

# 大屏监控 WS：默认留空时，本地 localhost 开发会直连 127.0.0.1:8000（不经 Vite，避免与 HMR WS 冲突）
# 若必须走 Vite 代理，设置：
# VITE_WS_DIRECT=0
# 或显式指定主机端口：
# VITE_WS_HOST=127.0.0.1:5173
