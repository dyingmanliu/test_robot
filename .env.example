# =============================================================================
# 环境变量模板：复制为仓库根目录 `.env` 后按需填写
#   cp .env.example .env
#
# Agent（CLI）与 Web 后端均从「仓库根目录」加载此文件（见 web/backend/app/main.py）。
# 前端构建请使用 web/frontend/.env.example。
# =============================================================================

# -----------------------------------------------------------------------------
# AutoGLM Agent（autoglm_phone_agent — main.py CLI 与 Web executor 共用）
# 设备层参考 Open-AutoGLM：https://github.com/zai-org/Open-AutoGLM
# -----------------------------------------------------------------------------
# 必填其一：智谱开放平台 API Key（https://bigmodel.cn/）
BIGMODEL_API_KEY=

# 可选：与 BIGMODEL_API_KEY 等价
# ZHIPU_API_KEY=

# 可选：OpenAI 兼容网关 Base URL
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 可选：模型名
PHONE_AGENT_MODEL=autoglm-phone

# 可选：单任务最大步数
PHONE_AGENT_MAX_STEPS=100

# 可选：多设备时指定 adb serial（adb devices）
# ADB_DEVICE_ID=                    # 可选；用例页「目标终端」可覆盖，多机时建议在界面选择
# DEVICE_SCREEN_MAX_WIDTH=540       # Web 投屏缩略图最大宽度（默认 540，避免超大 Base64 导致浏览器黑屏）

# CLI 默认设备类型（同 Open-AutoGLM --device-type）：adb | hdc
# PHONE_AGENT_DEVICE_TYPE=adb

# 鸿蒙（AutoGLM + HDC）；Android 用 ADB_DEVICE_ID
# HDC_DEVICE_ID=                    # 可选；用例页「目标终端」可覆盖
# HDC_HOME=/Applications/DevEco-Studio.app/Contents/sdk/default/openharmony/toolchains

# -----------------------------------------------------------------------------
# Midscene Agent（midscene_agent — 见 midscene_agent/README.md）
# Web 机器人实例可配置 test_agent_backend + device_platform；CLI 可用：
# MIDSCENE_DEVICE_PLATFORM=android|harmonyos
# -----------------------------------------------------------------------------
# Qwen3.6（仅 DashScope，与智谱 Key 不通用；见 https://dashscope.console.aliyun.com/）
# MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MIDSCENE_MODEL_API_KEY=          # 或单独设 DASHSCOPE_API_KEY=
# MIDSCENE_MODEL_NAME=qwen3.5-plus
# MIDSCENE_MODEL_FAMILY=qwen3.5
# 执行矩阵（Web 机器人实例字段 test_agent_backend × device_platform）：
#   autoglm + android     → autoglm_phone_agent（ADB，智谱）
#   autoglm + harmonyos   → autoglm_phone_agent + HDC（uitest）
#   midscene + android    → midscene_agent @midscene/android
#   midscene + harmonyos  → midscene_agent @midscene/harmony（千问/GLM 等）
# 若使用智谱 GLM-V，改用：
# MIDSCENE_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MIDSCENE_MODEL_API_KEY=          # 智谱 BIGMODEL_API_KEY
# MIDSCENE_MODEL_NAME=glm-5v-turbo
# MIDSCENE_MODEL_FAMILY=glm-v
# MIDSCENE_REPLANNING_CYCLE_LIMIT=50   # 单步 aiAct 内部重规划上限（默认 20）
# MIDSCENE_APP_NAME_MAP={"设置":"com.huawei.hmos.settings","懂车帝":"com.ss.dcar.auto/DcarAbility"}

# -----------------------------------------------------------------------------
# 用例编写 Agent（Web POST /api/test-cases/generate）
# -----------------------------------------------------------------------------
# CASE_GEN_API_KEY=
# CASE_GEN_BASE_URL=https://api.deepseek.com
# CASE_GEN_MODEL=deepseek-v4-pro
# CASE_GEN_TIMEOUT_SEC=120
# CASE_GEN_USE_KB=true
# CASE_GEN_KB_LIMIT=3

# -----------------------------------------------------------------------------
# mai_ui_agent（本地 MAI-UI-2B Grounding，见 mai_ui_agent/README.md）
# Mac M5 16GB 推荐 2B；默认对接 Ollama http://127.0.0.1:11434/v1
# -----------------------------------------------------------------------------
# MAI_UI_BACKEND=mlx_vlm
# MAI_UI_GROUNDING_URL=http://127.0.0.1:8101
# MAI_UI_MODEL_PATH=/path/to/mai_ui_agent/models/MAI-UI-2B-bf16-v2
# MAI_UI_BASE_URL=http://127.0.0.1:11434/v1
# MAI_UI_API_KEY=ollama
# MAI_UI_MODEL=maternion/mai-ui:2b

# -----------------------------------------------------------------------------
# Web 后端（JWT、SQLite、RBAC 引导）
# -----------------------------------------------------------------------------
# 生产环境务必替换为足够长的随机串
JWT_SECRET=change-me-in-production-use-long-random-string

# JWT 过期时间（分钟），默认 10080 ≈ 7 天
JWT_EXPIRE_MINUTES=10080

# 后端日志（见 app/logging_config.py）
# LOG_LEVEL=INFO
# LOG_FORMAT=detailed          # detailed | simple | custom（配合 LOG_FORMAT_TEMPLATE）
# LOG_FORMAT_TEMPLATE=%(asctime)s | %(message)s
# LOG_HTTP_QUERY=1             # HTTP 日志是否带 query
# LOG_HTTP_QUIET_POLLS=        # 设为 1 时 /health、GET /runs/{id} 降为 DEBUG
# LOG_SQL=                     # 设为 1 时输出 SQLAlchemy SQL

# 可选：SQLite 绝对路径；不设则默认 web/backend/data/tcm.db（相对仓库根）
# TCM_SQLITE_PATH=

# -----------------------------------------------------------------------------
# 内置平台管理员（仅当库中尚无任何 platform_admin 时生效；已有管理员则跳过）
# -----------------------------------------------------------------------------
# 默认邮箱 admin@localhost、密码 ChangeMe123!（务必在生产修改或禁用）
# TCM_BUILTIN_ADMIN_EMAIL=admin@localhost
# TCM_BUILTIN_ADMIN_PASSWORD=ChangeMe123!
# TCM_BUILTIN_ADMIN_USERNAME=platform_admin
# TCM_BUILTIN_ADMIN_COMPANY=内置平台
# 设为 1/true 则永不自动创建/提拔内置管理员
# TCM_DISABLE_BUILTIN_ADMIN=

# 可选：启动时将指定邮箱用户设为 platform_admin（首次运维）
# TCM_BOOTSTRAP_ADMIN_EMAIL=

# 可选：启动时将已注册手机号用户提升为 platform_admin（仅数字，须与 users.phone 一致）
# TCM_BOOTSTRAP_ADMIN_PHONE=

# 可选：大屏监控「空闲」模拟基线与抖动幅度（对接 Agent 管理后可弃用）
# ROBOT_MONITOR_IDLE_BASE=18
# ROBOT_MONITOR_IDLE_SPREAD=6

# -----------------------------------------------------------------------------
# 功能测试下发（Kafka）：不设则任务落库为 queued_local，由调度层后续接入
# -----------------------------------------------------------------------------
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# KAFKA_FUNCTIONAL_DISPATCH_TOPIC=functional-test-dispatch

# App 安装包上传目录（默认 web/backend/data/app_uploads）；不设则相对仓库根
# TCM_APP_UPLOAD_DIR=
# TCM_APP_UPLOAD_MAX_MB=200
