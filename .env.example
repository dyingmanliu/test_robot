# =============================================================================
# 环境变量总览
#
# 配置已按服务拆分为两个独立文件：
#   web/backend/.env     — Web 后端（数据库、JWT、日志、管理员、设备发现）
#   agent_service/.env   — Agent 服务（LLM Key、模型、用例生成、执行引擎）
#
# 加载规则：各服务优先读取自身目录下的 .env，缺失项回退到仓库根目录 .env。
# 首次部署：分别复制下方模板到对应目录，按需填写。
# 前端构建请使用 web/frontend/.env.example。
# =============================================================================

# ═══════════════════════════════════════════════════════════════════════════════
#  web/backend/.env  —  Web 后端专用
# ═══════════════════════════════════════════════════════════════════════════════

# ── 数据库 ────────────────────────────────────────────────────────────────────
# docker compose up -d mysql
DATABASE_URL=mysql+pymysql://tcm:tcm@127.0.0.1:3306/tcm?charset=utf8mb4
# TCM_DB_POOL_SIZE=10
# TCM_DB_MAX_OVERFLOW=20

# ── JWT 认证 ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=10080

# ── 日志 ──────────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_FORMAT=detailed          # detailed | simple | custom（配合 LOG_FORMAT_TEMPLATE）
# LOG_FORMAT_TEMPLATE=%(asctime)s | %(message)s
# LOG_HTTP_QUERY=1
# LOG_HTTP_QUIET_POLLS=        # 设为 1 时轮询接口降为 DEBUG
# LOG_SQL=                     # 设为 1 时输出 SQLAlchemy SQL

# ── 内置管理员（首次启动无 admin 时自动创建）──────────────────────────────────
# TCM_BUILTIN_ADMIN_EMAIL=admin@localhost
# TCM_BUILTIN_ADMIN_PASSWORD=ChangeMe123!
# TCM_BUILTIN_ADMIN_USERNAME=platform_admin
# TCM_BUILTIN_ADMIN_COMPANY=内置平台
# TCM_DISABLE_BUILTIN_ADMIN=
# TCM_BOOTSTRAP_ADMIN_EMAIL=
# TCM_BOOTSTRAP_ADMIN_PHONE=

# ── Agent Service 连接 ────────────────────────────────────────────────────────
AGENT_SERVICE_URL=http://127.0.0.1:8100
# 与 agent_service/.env 相同；供 internal KB API（Bearer）与 WebCaseKbRetriever
WEB_SERVICE_TOKEN=

# ── 设备发现/展示（Web 设备列表、屏幕镜像）───────────────────────────────────
# ADB_DEVICE_ID=
# HDC_DEVICE_ID=
# HDC_HOME=/Applications/DevEco-Studio.app/Contents/sdk/default/openharmony/toolchains
# DEVICE_SCREEN_MAX_WIDTH=540

# ── Kafka（可选）──────────────────────────────────────────────────────────────
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# KAFKA_FUNCTIONAL_DISPATCH_TOPIC=functional-test-dispatch

# ── 应用上传 ──────────────────────────────────────────────────────────────────
# TCM_APP_UPLOAD_DIR=
# TCM_APP_UPLOAD_MAX_MB=200

# ═══════════════════════════════════════════════════════════════════════════════
#  agent_service/.env  —  Agent 服务专用
# ═══════════════════════════════════════════════════════════════════════════════

# ── Agent Service 监听 ────────────────────────────────────────────────────────
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8100

# ── LangSmith（可选，LangChain 调用追踪）────────────────────────────────────
# LANGSMITH_API_KEY=
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=test-robots

# ── 日志（与 web/backend 一致）──────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_FORMAT=detailed
# LOG_HTTP_QUERY=1
# LOG_HTTP_QUIET_POLLS=
# LOG_HTTP=

# ── 智谱 API Key（AutoGLM 执行 + 用例生成兜底）─────────────────────────────
BIGMODEL_API_KEY=
# ZHIPU_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── AutoGLM 执行引擎 ────────────────────────────────────────────────────────
PHONE_AGENT_MODEL=autoglm-phone
PHONE_AGENT_MAX_STEPS=100
# PHONE_AGENT_DEVICE_TYPE=adb

# ── Midscene 执行引擎 ───────────────────────────────────────────────────────
# MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MIDSCENE_MODEL_API_KEY=          # 或单独设 DASHSCOPE_API_KEY=
# MIDSCENE_MODEL_NAME=qwen3.5-plus
# MIDSCENE_MODEL_FAMILY=qwen3.5
# 若使用智谱 GLM-V，改用：
# MIDSCENE_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MIDSCENE_MODEL_API_KEY=          # 智谱 BIGMODEL_API_KEY
# MIDSCENE_MODEL_NAME=glm-5v-turbo
# MIDSCENE_MODEL_FAMILY=glm-v
# MIDSCENE_REPLANNING_CYCLE_LIMIT=50
# MIDSCENE_STEP_TIMEOUT_SEC=300
# MIDSCENE_EXPLORE_STEP_TIMEOUT_SEC=120
# EXPLORE_TRAVERSE_MODE=hybrid
# MIDSCENE_APP_NAME_MAP={"设置":"com.huawei.hmos.settings"}

# ── 用例生成 Agent ──────────────────────────────────────────────────────────
# CASE_GEN_API_KEY=
# CASE_GEN_BASE_URL=https://api.deepseek.com
# CASE_GEN_MODEL=deepseek-v4-pro
# CASE_GEN_TIMEOUT_SEC=120
# CASE_GEN_USE_KB=true
# CASE_GEN_KB_LIMIT=3

# ── 设备连接（CLI + agent_service 执行用）────────────────────────────────────
# ADB_DEVICE_ID=
# HDC_DEVICE_ID=
# HDC_HOME=/Applications/DevEco-Studio.app/Contents/sdk/default/openharmony/toolchains
# LangChain KB Retriever（agent_service 调 Web internal API，与 web/backend 相同 token）
WEB_INTERNAL_API_URL=http://127.0.0.1:8000
WEB_SERVICE_TOKEN=tcm_dev_internal_7f3a9e2b4c1d8f6a0e5b3c9d2f7a4e1
